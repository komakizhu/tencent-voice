#!/bin/sh
set -eu

package_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bin_dir=$(swift build --package-path "$package_root" --show-bin-path)
binary="$bin_dir/RimeAuditMCP"

if [ ! -x "$binary" ]; then
    swift build --package-path "$package_root" --product RimeAuditMCP >/dev/null
fi

exec "$binary" "$@"
